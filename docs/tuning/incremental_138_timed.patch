+/// Per-square contribution to each instance's index when the mover owns it.
+static SQUARES: LazyLock<Vec<[u16; LANES]>> = LazyLock::new(|| {
+    let mut table = vec![[0u16; LANES]; 64];
+    for (slot, instance) in instances().iter().enumerate() {
+        let mut power = 1;
+        for &square in &instance.squares {
+            table[usize::from(square)][slot] += power;
+            power *= 3;
+        }
+    }
+    table
+});
+
+pub type Sums = ([u16; LANES], [u16; LANES]);
+
+/// Index sums of the mover's and of the opponent's discs, apart.
+pub fn sums(board: Board) -> Sums {
+    let (mut me, mut opp) = ([0u16; LANES], [0u16; LANES]);
+    for row in 0..8 {
+        let a = &ROWS[row * 256 + (board.me >> (row * 8) & 0xff) as usize];
+        let b = &ROWS[row * 256 + (board.opp >> (row * 8) & 0xff) as usize];
+        for (((me, opp), &a), &b) in me.iter_mut().zip(opp.iter_mut()).zip(a).zip(b) {
+            *me += a;
+            *opp += b;
+        }
+    }
+    (me, opp)
+}
+
+/// The evaluation of `child`, reached from `parent` by one move, from the parent's sums.
+pub fn evaluate_child(parent: Board, sums: &Sums, child: Board) -> i32 {
+    let flipped = parent.opp & !child.me;
+    let placed = child.opp & !parent.me & !flipped;
+    // child's mover is the parent's opponent
+    let (mut me, mut opp) = (sums.1, sums.0);
+    let add = &SQUARES[placed.trailing_zeros() as usize];
+    for lane in 0..LANES {
+        opp[lane] += add[lane];
+    }
+    let mut rest = flipped;
+    while rest != 0 {
+        let row = &SQUARES[rest.trailing_zeros() as usize];
+        for lane in 0..LANES {
+            me[lane] -= row[lane];
+            opp[lane] += row[lane];
+        }
+        rest &= rest - 1;
+    }
+    let mut index = [0u16; LANES];
+    for lane in 0..LANES {
+        index[lane] = me[lane] + 2 * opp[lane];
+    }
+    let table = &TABLE[stage(empty_count(child)) * TABLE_SLOTS..][..TABLE_SLOTS];
+    let mut value = 0;
+    for (index, offset) in index.into_iter().zip(*OFFSETS) {
+        value += i32::from(table[(offset + u32::from(index)) as usize]);
+    }
+    value.clamp(-EVAL_BOUND, EVAL_BOUND)
+}
